import kotlin.String;
import kotlin.collections.List;
import kotlinx.datetime.Instant;

CREATE TABLE AccountEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    name TEXT NOT NULL,
    isDefault INTEGER NOT NULL DEFAULT 0,
    type TEXT NOT NULL,
    balance TEXT NOT NULL DEFAULT '0',
    linkedSources TEXT AS List<String> NOT NULL,
    createdAt INTEGER AS Instant NOT NULL,
    lastSyncedAt INTEGER AS Instant
);

CREATE TABLE CategoryEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT,
    name TEXT NOT NULL,
    isExpense INTEGER NOT NULL DEFAULT 1,
    iconName TEXT,
    isDefault INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER AS Instant NOT NULL
);

CREATE TABLE TransactionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    accountId TEXT NOT NULL,
    categoryId TEXT NOT NULL,
    isIncome INTEGER NOT NULL,
    amount TEXT NOT NULL,
    transactionCost TEXT NOT NULL DEFAULT '0',
    dateTime INTEGER AS Instant NOT NULL,
    description TEXT,
    externalId TEXT UNIQUE,
    balance TEXT,
    createdAt INTEGER AS Instant NOT NULL,
    updatedAt INTEGER AS Instant NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (categoryId) REFERENCES CategoryEntity(id) ON DELETE CASCADE
);

CREATE TABLE BudgetEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    name TEXT NOT NULL,
    limitAmount TEXT NOT NULL,
    isExpense INTEGER NOT NULL DEFAULT 1,
    startDate TEXT NOT NULL,
    endDate TEXT NOT NULL,
    categoryIds TEXT NOT NULL,
    accountIds TEXT NOT NULL,
    createdAt INTEGER AS Instant NOT NULL
);

-- Indices
CREATE INDEX transaction_user_date ON TransactionEntity(userId, dateTime);
CREATE INDEX transaction_account_date ON TransactionEntity(accountId, dateTime);
CREATE INDEX category_user_name ON CategoryEntity(userId, name);
CREATE INDEX budget_user ON BudgetEntity(userId);

-- Queries
insertAccount:
INSERT OR REPLACE INTO AccountEntity(id, userId, name, isDefault, type, balance, linkedSources, createdAt, lastSyncedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllAccounts:
SELECT * FROM AccountEntity WHERE userId = ? ORDER BY createdAt ASC, name COLLATE NOCASE ASC;

selectAccountById:
SELECT * FROM AccountEntity WHERE id = ?;

updateAccountBalance:
UPDATE AccountEntity SET balance = ? WHERE id = ?;

deleteAccount:
DELETE FROM AccountEntity WHERE id = ?;

insertCategory:
INSERT OR REPLACE INTO CategoryEntity(id, userId, name, isExpense, iconName, isDefault, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAllCategories:
SELECT * FROM CategoryEntity WHERE userId = ? OR isDefault = 1;

selectCategoryById:
SELECT * FROM CategoryEntity WHERE id = ?;

deleteCategory:
DELETE FROM CategoryEntity WHERE id = ?;

reassignTransactions:
UPDATE TransactionEntity SET categoryId = :newCategoryId WHERE categoryId = :oldCategoryId AND userId = :userId;

insertTransaction:
INSERT OR REPLACE INTO TransactionEntity(id, userId, accountId, categoryId, isIncome, amount, transactionCost, dateTime, description, externalId, balance, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateTransaction:
UPDATE TransactionEntity
SET accountId = ?, categoryId = ?, isIncome = ?, amount = ?, transactionCost = ?, dateTime = ?, description = ?, balance = ?, updatedAt = ?
WHERE id = ?;

selectAllTransactionsWithCategory:
SELECT T.id, T.accountId, T.categoryId, T.isIncome, T.amount, T.transactionCost, T.dateTime, T.description, T.externalId, T.balance, C.name AS categoryName
FROM TransactionEntity T
LEFT JOIN CategoryEntity C ON T.categoryId = C.id
WHERE T.userId = ?
ORDER BY T.dateTime DESC;

selectAllTransactions:
SELECT id, accountId, categoryId, isIncome, amount, transactionCost, dateTime, description, externalId, balance FROM TransactionEntity WHERE userId = ? ORDER BY dateTime DESC;

selectTransactionsByRange:
SELECT T.id, T.accountId, T.categoryId, T.isIncome, T.amount, T.transactionCost, T.dateTime, T.description, T.externalId, T.balance, C.name AS categoryName
FROM TransactionEntity T
LEFT JOIN CategoryEntity C ON T.categoryId = C.id
WHERE T.userId = ? AND T.dateTime >= ? AND T.dateTime <= ?
ORDER BY T.dateTime DESC;

selectTransactionsByAccount:
SELECT id, accountId, categoryId, isIncome, amount, transactionCost, dateTime, description, externalId, balance FROM TransactionEntity WHERE accountId = ? ORDER BY dateTime DESC;

selectRecentTransactionsByAccount:
SELECT id, accountId, categoryId, isIncome, amount, transactionCost, dateTime, description, externalId, balance FROM TransactionEntity WHERE accountId = :accountId ORDER BY dateTime DESC LIMIT :limit;

getLatestTransactionBalance:
SELECT balance FROM TransactionEntity WHERE accountId = ? ORDER BY dateTime DESC LIMIT 1;

deleteTransaction:
DELETE FROM TransactionEntity WHERE id = ?;

selectTransactionById:
SELECT id, accountId, categoryId, isIncome, amount, transactionCost, dateTime, description, externalId, balance FROM TransactionEntity WHERE id = ?;

countTransactions:
SELECT COUNT(*) FROM TransactionEntity
WHERE userId = :userId
AND (:accountId IS NULL OR accountId = :accountId)
AND (:isIncome IS NULL OR isIncome = :isIncome)
AND (:useCategoryFilter = 0 OR categoryId IN :categoryIds)
AND (:start IS NULL OR dateTime >= :start)
AND (:end IS NULL OR dateTime <= :end)
AND (:hasTransactionCost IS NULL OR (CAST(transactionCost AS REAL) > 0) = :hasTransactionCost);

selectTransactionsPaged:
SELECT T.id, T.accountId, T.categoryId, T.isIncome, T.amount, T.transactionCost, T.dateTime, T.description, T.externalId, T.balance, C.name AS categoryName
FROM TransactionEntity T
LEFT JOIN CategoryEntity C ON T.categoryId = C.id
WHERE T.userId = :userId
AND (:accountId IS NULL OR T.accountId = :accountId)
AND (:isIncome IS NULL OR T.isIncome = :isIncome)
AND (:useCategoryFilter = 0 OR T.categoryId IN :categoryIds)
AND (:start IS NULL OR T.dateTime >= :start)
AND (:end IS NULL OR T.dateTime <= :end)
AND (:hasTransactionCost IS NULL OR (CAST(T.transactionCost AS REAL) > 0) = :hasTransactionCost)
ORDER BY T.dateTime DESC
LIMIT :limit OFFSET :offset;

-- Aggregation Queries
getDailyTotals:
SELECT
    date(dateTime / 1000, 'unixepoch') AS day,
    SUM(CASE WHEN isIncome = 1 THEN CAST(amount AS REAL) - CAST(transactionCost AS REAL) ELSE 0 END) AS incomeTotal,
    SUM(CASE WHEN isIncome = 0 THEN CAST(amount AS REAL) + CAST(transactionCost AS REAL) ELSE 0 END) AS expenseTotal
FROM TransactionEntity
WHERE userId = :userId AND (:accountId IS NULL OR accountId = :accountId) AND dateTime >= :start AND dateTime <= :end
GROUP BY day
ORDER BY day ASC;

getCategoryTotals:
SELECT
    C.name AS catName,
    C.id AS catId,
    SUM(CASE WHEN T.isIncome = 1 THEN CAST(T.amount AS REAL) - CAST(T.transactionCost AS REAL) ELSE CAST(T.amount AS REAL) + CAST(T.transactionCost AS REAL) END) AS totalSum,
    COUNT(*) AS txCount
FROM TransactionEntity T
JOIN CategoryEntity C ON T.categoryId = C.id
WHERE T.userId = :userId AND (:accountId IS NULL OR accountId = :accountId) AND (:isIncome IS NULL OR T.isIncome = :isIncome) AND T.dateTime >= :start AND T.dateTime <= :end
GROUP BY catId
ORDER BY totalSum DESC;

getHighlights:
SELECT
    SUM(CASE WHEN isIncome = 1 THEN CAST(amount AS REAL) - CAST(transactionCost AS REAL) ELSE 0 END) AS incomeTotal,
    SUM(CASE WHEN isIncome = 0 THEN CAST(amount AS REAL) + CAST(transactionCost AS REAL) ELSE 0 END) AS expenseTotal,
    SUM(CAST(transactionCost AS REAL)) AS feesTotal
FROM TransactionEntity
WHERE (:accountId IS NULL OR accountId = :accountId) AND (userId = :userId);

getHighlightsByRange:
SELECT
    SUM(CASE WHEN isIncome = 1 THEN CAST(amount AS REAL) - CAST(transactionCost AS REAL) ELSE 0 END) AS incomeTotal,
    SUM(CASE WHEN isIncome = 0 THEN CAST(amount AS REAL) + CAST(transactionCost AS REAL) ELSE 0 END) AS expenseTotal,
    SUM(CAST(transactionCost AS REAL)) AS feesTotal
FROM TransactionEntity
WHERE (:accountId IS NULL OR accountId = :accountId) AND (userId = :userId) AND dateTime >= :start AND dateTime <= :end;

getTest:
SELECT 1;

selectDistinctMonths:
SELECT DISTINCT strftime('%Y-%m', dateTime / 1000, 'unixepoch') AS month
FROM TransactionEntity
WHERE userId = ? AND (:accountId IS NULL OR accountId = :accountId)
ORDER BY month DESC;

selectDistinctYears:
SELECT DISTINCT strftime('%Y', dateTime / 1000, 'unixepoch') AS year
FROM TransactionEntity
WHERE userId = ? AND (:accountId IS NULL OR accountId = :accountId)
ORDER BY year DESC;

selectDistinctWeeks:
SELECT DISTINCT strftime('%Y-W%W', dateTime / 1000, 'unixepoch') AS week
FROM TransactionEntity
WHERE userId = ? AND (:accountId IS NULL OR accountId = :accountId)
ORDER BY week DESC;

getTransactionCountSummary:
SELECT
    COUNT(CASE WHEN isIncome = 1 THEN 1 END) AS incomeCount,
    COUNT(CASE WHEN isIncome = 0 THEN 1 END) AS expenseCount,
    COUNT(*) AS totalCount,
    SUM(CAST(transactionCost AS REAL)) AS totalTransactionCost,
    SUM(CASE WHEN isIncome = 1 THEN CAST(amount AS REAL) - CAST(transactionCost AS REAL) ELSE CAST(amount AS REAL) + CAST(transactionCost AS REAL) END) AS totalAmount
FROM TransactionEntity
WHERE userId = :userId
AND (:accountId IS NULL OR accountId = :accountId)
AND (:isIncome IS NULL OR isIncome = :isIncome)
AND (:useCategoryFilter = 0 OR categoryId IN :categoryIds)
AND (:start IS NULL OR dateTime >= :start)
AND (:end IS NULL OR dateTime <= :end)
AND (:hasTransactionCost IS NULL OR (CAST(transactionCost AS REAL) > 0) = :hasTransactionCost);

getNetWorth:
SELECT SUM(CAST(balance AS REAL)) AS netWorth FROM AccountEntity WHERE userId = ?;

-- Budget Queries
insertBudget:
INSERT OR REPLACE INTO BudgetEntity(id, userId, name, limitAmount, isExpense, startDate, endDate, categoryIds, accountIds, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllBudgets:
SELECT * FROM BudgetEntity WHERE userId = ?;

selectBudgetById:
SELECT * FROM BudgetEntity WHERE id = ?;

deleteBudget:
DELETE FROM BudgetEntity WHERE id = ?;

deleteAllBudgets:
DELETE FROM BudgetEntity WHERE userId = ?;
